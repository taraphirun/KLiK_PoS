 "html": "<style>\n\t@media screen {\n\t\t.print-format {\n\t\t\tmargin: 0 auto;\n\t\t\tbackground: white;\n\t\t\tbox-shadow: 0 0 10px rgba(0,0,0,0.1);\n\t\t}\n\t}\n\t\n\t@media print {\n\t\t.print-format {\n\t\t\tmargin: 0;\n\t\t}\n\t\t\n\t}\n\t\n\t.print-format {\n\t\tfont-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n\t\tfont-size: 10pt;\n\t\tcolor: #333;\n\t\tline-height: 1.4;\n\t}\n\t\n\t.invoice-header {\n\t\tborder-bottom: 3px solid #2c3e50;\n\t\tpadding-bottom: 15px;\n\t\tmargin-bottom: 20px;\n\t}\n\t\n\t.company-name {\n\t\tfont-size: 20pt;\n\t\tfont-weight: bold;\n\t\tcolor: #2c3e50;\n\t\tmargin-bottom: 5px;\n\t}\n\t\n\t.invoice-title {\n\t\tfont-size: 14pt;\n\t\tfont-weight: bold;\n\t\tcolor: #e74c3c;\n\t\ttext-transform: uppercase;\n\t\tletter-spacing: 1px;\n\t}\n\t\n\t.invoice-info {\n\t\tdisplay: grid;\n\t\tgrid-template-columns: 1fr 1fr;\n\t\tgap: 30px;\n\t\tmargin-bottom: 20px;\n\t}\n\t\n\t@media print {\n\t\t.invoice-info {\n\t\t\tdisplay: grid;\n\t\t\tgrid-template-columns: 1fr 1fr;\n\t\t\tgap: 30px;\n\t\t}\n\t}\n\t\n\t.info-section h3 {\n\t\tfont-size: 9pt;\n\t\tfont-weight: bold;\n\t\tcolor: #7f8c8d;\n\t\ttext-transform: uppercase;\n\t\tmargin-bottom: 8px;\n\t\tborder-bottom: 1px solid #ecf0f1;\n\t\tpadding-bottom: 3px;\n\t}\n\t\n\t.info-section p {\n\t\tmargin: 3px 0;\n\t\tfont-size: 10pt;\n\t}\n\t\n\t.info-label {\n\t\tfont-weight: 600;\n\t\tcolor: #555;\n\t\tdisplay: inline-block;\n\t\twidth: 80px;\n\t}\n\t\n\t.status-paid {\n\t\tcolor: #27ae60;\n\t\tfont-weight: bold;\n\t}\n\t\n\t.status-partly-paid {\n\t\tcolor: #f39c12;\n\t\tfont-weight: bold;\n\t}\n\t\n\t.status-unpaid {\n\t\tcolor: #e74c3c;\n\t\tfont-weight: bold;\n\t}\n\t\n\t.items-table {\n\t\twidth: 100%;\n\t\tborder-collapse: collapse;\n\t\tmargin-bottom: 20px;\n\t}\n\t\n\t.items-table thead {\n\t\tbackground-color: #34495e;\n\t\tcolor: white;\n\t}\n\t\n\t.items-table th {\n\t\tpadding: 10px 8px;\n\t\ttext-align: left;\n\t\tfont-weight: 600;\n\t\tfont-size: 9pt;\n\t\ttext-transform: uppercase;\n\t}\n\t\n\t.items-table th.text-right {\n\t\ttext-align: right;\n\t}\n\t\n\t.items-table tbody tr {\n\t\tborder-bottom: 1px solid #ecf0f1;\n\t}\n\t\n\t.items-table tbody tr:nth-child(even) {\n\t\tbackground-color: #f8f9fa;\n\t}\n\t\n\t.items-table td {\n\t\tpadding: 8px;\n\t\tfont-size: 10pt;\n\t}\n\t\n\t.items-table td.text-right {\n\t\ttext-align: right;\n\t}\n\t\n\t.item-details {\n\t\tfont-size: 9pt;\n\t\tcolor: #7f8c8d;\n\t\tmargin-top: 2px;\n\t}\n\t\n\t.totals-table {\n\t\twidth: 100%;\n\t\tmargin-bottom: 15px;\n\t}\n\t\n\t.totals-table td {\n\t\tpadding: 5px 8px;\n\t\tfont-size: 10pt;\n\t}\n\t\n\t.totals-table td:first-child {\n\t\ttext-align: right;\n\t\tcolor: #555;\n\t}\n\t\n\t.totals-table td:last-child {\n\t\ttext-align: right;\n\t\tfont-weight: 600;\n\t\twidth: 120px;\n\t}\n\t\n\t.totals-table .grand-total td {\n\t\tfont-size: 12pt;\n\t\tfont-weight: bold;\n\t\tcolor: #2c3e50;\n\t\tborder-top: 2px solid #34495e;\n\t\tborder-bottom: 3px double #34495e;\n\t\tpadding: 10px 8px;\n\t}\n\t\n\t.totals-table .subtotal-row td {\n\t\tborder-top: 1px solid #ecf0f1;\n\t\tpadding-top: 10px;\n\t}\n\t\n\t.payment-section {\n\t\tbackground-color: #ecf0f1;\n\t\tpadding: 10px;\n\t\tborder-radius: 5px;\n\t\tmargin-bottom: 15px;\n\t}\n\t\n\t.payment-section h4 {\n\t\tmargin: 0 0 8px 0;\n\t\tfont-size: 10pt;\n\t\tcolor: #2c3e50;\n\t\ttext-transform: uppercase;\n\t}\n\t\n\t.invoice-footer {\n\t\tmargin-top: 20px;\n\t\tpadding-top: 15px;\n\t\tborder-top: 1px solid #bdc3c7;\n\t}\n\t\n\t.terms {\n\t\tfont-size: 8pt;\n\t\tcolor: #7f8c8d;\n\t\tmargin-bottom: 10px;\n\t\tline-height: 1.3;\n\t}\n\t\n\t.thank-you {\n\t\ttext-align: center;\n\t\tfont-size: 11pt;\n\t\tcolor: #27ae60;\n\t\tfont-weight: 600;\n\t\tmargin-top: 15px;\n\t}\n</style>\n\n<div class=\"print-format\">\n\t{% if letter_head %}\n\t\t{{ letter_head }}\n\t{% endif %}\n\t\n\t<div class=\"invoice-header\">\n\t\t<div class=\"company-name\">{{ doc.company }}</div>\n\t\t<div class=\"invoice-title\">{{ doc.select_print_heading or _(\"Invoice\") }}</div>\n\t</div>\n\t\n\t<div class=\"invoice-info\">\n\t\t<div class=\"info-section\">\n\t\t\t<h3>Invoice Details</h3>\n\t\t\t<p><span class=\"info-label\">Receipt No:</span> {{ doc.name }}</p>\n\t\t\t<p><span class=\"info-label\">Status:</span> \n\t\t\t\t<span class=\"{% if doc.status == 'Paid' %}status-paid{% elif doc.status == 'Partly Paid' %}status-partly-paid{% elif doc.status == 'Unpaid' %}status-unpaid{% endif %}\">\n\t\t\t\t\t{{ doc.status }}\n\t\t\t\t</span>\n\t\t\t</p>\n\t\t\t<p><span class=\"info-label\">Date:</span> {{ doc.get_formatted(\"posting_date\") }} @ {{ doc.get_formatted(\"posting_time\") }}</p>\n\t\t</div>\n\t\t\n\t\t<div class=\"info-section\">\n\t\t\t<h3>{{_(\"Customer Information\")}}</h3>\n\t\t\t<p><span class=\"info-label\">{{_(\"Customer\")}}:</span> {{ doc.customer_name }}</p>\n\t\t\t{%- set credit_info = get_customer_credit_summary(doc.customer, doc.company) -%}\n\t\t\t{%- if credit_info and credit_info.credit_limit %}\n\t\t\t<p><span class=\"info-label\">{{_(\"Credit Limit\")}}:</span> {{ frappe.format_value(credit_info.credit_limit, {\"fieldtype\": \"Currency\", \"options\": doc.currency}) }}</p>\n\t\t\t<p><span class=\"info-label\">{{_(\"Credit Used\")}}:</span> {{ frappe.format_value(credit_info.credit_used, {\"fieldtype\": \"Currency\", \"options\": doc.currency}) }}</p>\n\t\t\t{%- if credit_info.credit_available is not none %}\n\t\t\t<p><span class=\"info-label\">{{_(\"Available\")}}:</span> {{ frappe.format_value(credit_info.credit_available, {\"fieldtype\": \"Currency\", \"options\": doc.currency}) }}</p>\n\t\t\t{%- endif %}\n\t\t\t{%- endif %}\n\t\t</div>\n\t</div>\n\t\n\t<table class=\"items-table\">\n\t\t<thead>\n\t\t\t<tr>\n\t\t\t\t<th width=\"50%\">{{ _(\"Item\") }}</th>\n\t\t\t\t<th width=\"15%\" class=\"text-right\">{{ _(\"Qty\") }}</th>\n\t\t\t\t<th width=\"17%\" class=\"text-right\">{{ _(\"Rate\") }}</th>\n\t\t\t\t<th width=\"18%\" class=\"text-right\">{{ _(\"Amount\") }}</th>\n\t\t\t</tr>\n\t\t</thead>\n\t\t<tbody>\n\t\t\t{%- for item in doc.items -%}\n\t\t\t<tr>\n\t\t\t\t<td>\n\t\t\t\t\t<strong>{{ item.item_name }}</strong>\n\t\t\t\t\t{%- if item.item_name != item.description -%}\n\t\t\t\t\t\t<div class=\"item-details\">{{ item.description }}</div>\n\t\t\t\t\t{%- endif -%}\n\t\t\t\t\t{%- if item.custom_description -%}\n\t\t\t\t\t\t<div class=\"item-details\">{{ item.custom_description }}</div>\n\t\t\t\t\t{%- endif -%}\n\t\t\t\t\t{%- if item.serial_no -%}\n\t\t\t\t\t\t<div class=\"item-details\"><strong>{{ _(\"SR.No\") }}:</strong> {{ item.serial_no | replace(\"\\n\", \", \") }}</div>\n\t\t\t\t\t{%- endif -%}\n\t\t\t\t</td>\n\t\t\t\t<td class=\"text-right\">{{ item.qty }}</td>\n\t\t\t\t<td class=\"text-right\">{{ item.get_formatted(\"rate\") }}</td>\n\t\t\t\t<td class=\"text-right\">{{ item.get_formatted(\"amount\") }}</td>\n\t\t\t</tr>\n\t\t\t{%- endfor -%}\n\t\t</tbody>\n\t</table>\n\t\n\t<table class=\"totals-table\">\n\t\t<tbody>\n\t\t\t<tr class=\"subtotal-row\">\n\t\t\t\t<td>{{ _(\"Subtotal\") }}</td>\n\t\t\t\t<td>{{ doc.get_formatted(\"total\", doc) }}</td>\n\t\t\t</tr>\n\t\t\t{%- if doc.discount_amount -%}\n\t\t\t<tr>\n\t\t\t\t<td>{{ _(\"Discount\") }}</td>\n\t\t\t\t<td>-{{ doc.get_formatted(\"discount_amount\") }}</td>\n\t\t\t</tr>\n\t\t\t{%- endif -%}\n\t\t\t<tr>\n\t\t\t\t<td>{{ _(\"Amount Paid\") }}</td>\n\t\t\t\t<td>{%- if doc.paid_amount -%}{{ doc.get_formatted(\"paid_amount\") }}{%- else -%}{{ frappe.format_value(doc.grand_total - doc.outstanding_amount, {\"fieldtype\": \"Currency\", \"options\": doc.currency}) }}{%- endif -%}</td>\n\t\t\t</tr>\n\t\t\t<tr class=\"grand-total\">\n\t\t\t\t<td>{{ _(\"Remaining Amount\") }}</td>\n\t\t\t\t<td>{{ doc.get_formatted(\"outstanding_amount\") }}</td>\n\t\t\t</tr>\n\t\t</tbody>\n\t</table>\n\t\n\t{%- if doc.payments -%}\n\t<div class=\"payment-section\">\n\t\t<h4>{{ _(\"Payment Details\") }}</h4>\n\t\t<table class=\"totals-table\" style=\"margin-bottom: 5px;\">\n\t\t\t<tbody>\n\t\t\t\t{%- for row in doc.payments -%}\n\t\t\t\t<tr>\n\t\t\t\t\t<td>{{ row.mode_of_payment }}</td>\n\t\t\t\t\t<td>{{ row.get_formatted(\"amount\", doc) }}</td>\n\t\t\t\t</tr>\n\t\t\t\t{%- endfor -%}\n\t\t\t\t{%- if doc.change_amount -%}\n\t\t\t\t<tr style=\"border-top: 1px solid #bdc3c7;\">\n\t\t\t\t\t<td><strong>{{ _(\"Change Amount\") }}</strong></td>\n\t\t\t\t\t<td><strong>{{ doc.get_formatted(\"change_amount\") }}</strong></td>\n\t\t\t\t</tr>\n\t\t\t\t{%- endif -%}\n\t\t\t</tbody>\n\t\t</table>\n\t</div>\n\t{%- endif -%}\n\t\n\t<div class=\"invoice-footer\">\n\t\t{%- if doc.terms -%}\n\t\t<div class=\"terms\">\n\t\t\t<strong>Terms & Conditions:</strong><br>\n\t\t\t{{ doc.terms }}\n\t\t</div>\n\t\t{%- endif -%}\n\t\t<div class=\"thank-you\">{{ _(\"Thank you for your business!\") }}</div>\n\t</div>\n</div>",
