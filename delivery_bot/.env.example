# Required: Telegram bot token (from @BotFather)
DELIVERY_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Redis - used only for aiogram's own FSM state storage and photo-album batching (Todo 036: no
# longer used as a database; Postgres/MinIO are retired entirely).
REDIS_URL=redis://localhost:6379/0

# Comma-separated Telegram user IDs who get admin commands (/syncstatus) and registration
# approval DMs. Changing this needs a bot restart (was previously DB-backed, is now static env
# config as of Todo 036).
ADMIN_TELEGRAM_IDS=

# Group chat (and optional forum topic) deliveries get forwarded to after logging. Leave
# REPORTING_CHAT_ID blank to skip group forwarding entirely.
REPORTING_CHAT_ID=
REPORTING_TOPIC_ID=

# Timezone used for the "Time:" line in the group-forward message (IANA name).
LOCAL_TZ=Asia/Phnom_Penh

# KlikPOS (Frappe) sync target - Module 14. Create a dedicated API user in KlikPOS
# (Desk -> User, generate API keys) rather than reusing an admin account.
KLIKPOS_BASE_URL=https://your-klikpos-site.example.com
KLIKPOS_API_KEY=
KLIKPOS_API_SECRET=
